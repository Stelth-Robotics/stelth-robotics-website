---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  statement: string;
  heroImages?: string[];
}

const { title, description, statement, heroImages } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
        .hero-section {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 100%;
			gap: 1.5rem;
			padding: 2rem 1rem;
		}

		.hero-title {
			font-size: 2.5rem;
			font-weight: bold;
			text-align: center;
			margin: 0;
		}

  		.hero-container {
			display: flex;
			justify-content: center;
			align-items: center;
			width: 100%;
			position: relative;
			gap: 1rem;
		}

		.hero-image {
			position: relative;
			display: inline-block;
			max-width: 1020px;
			width: 100%;
		}
	
		#hero-img {
			max-width: 100%;
			height: auto;
			display: block;
		}

		.arrow {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			background: rgba(0, 0, 0, 0.5);
			color: white;
			border: none;
			font-size: 2rem;
			padding: 1rem 1.5rem;
			cursor: pointer;
			border-radius: 4px;
			transition: background 0.3s ease;
			z-index: 10;
			opacity: 0.25;
		}

		.arrow:hover {
			background: rgba(0, 0, 0, 0.8);
			opacity: 1;
		}

		.arrow:active {
			transform: translateY(-50%) scale(0.95);
		}
		.arrow-left {
			left: 1rem;
		}

		.arrow-right {
			right: 1rem;
		}
		</style>
	</head>
	<body>
		<Header />
		{heroImages && heroImages.length > 0 && (
            <div class="hero-section">
				<h2 class="hero-statement">{statement}</h2>
			    <div class="hero-container">
  				    <div class="hero-image" data-images={JSON.stringify(heroImages)}>
    				    <img id="hero-img" width={1020} height={510} src={heroImages[0]} alt="" />
    				    <button class="arrow arrow-left" id="prev-btn">‹</button>
    				    <button class="arrow arrow-right" id="next-btn">›</button>
  				    </div>
                </div>
			</div>
		)}
		
		<slot />
		
		<Footer />
		
		{heroImages && heroImages.length > 0 && (
			<script is:inline>
				document.addEventListener('DOMContentLoaded', () => {
					const container = document.querySelector('.hero-image');
					const images = JSON.parse(container.dataset.images);
					const imgElement = document.getElementById('hero-img');
					const prevBtn = document.getElementById('prev-btn');
					const nextBtn = document.getElementById('next-btn');
					let index = 0;
					let autoSlide;

					function updateImage() {
						imgElement.src = images[index];
					}

					function nextImage() {
						index = (index + 1) % images.length;
						updateImage();
					}

					function prevImage() {
						index = (index - 1 + images.length) % images.length;
						updateImage();
					}

					function startAutoSlide() {
						autoSlide = setInterval(nextImage, 5000);
					}

					function resetAutoSlide() {
						clearInterval(autoSlide);
						startAutoSlide();
					}

					nextBtn.addEventListener('click', () => {
						nextImage();
						resetAutoSlide();
					});

					prevBtn.addEventListener('click', () => {
						prevImage();
						resetAutoSlide();
					});

					startAutoSlide();
				});
			</script>
		)}
	</body>
</html>